#!/bin/sh /etc/rc.common
# OpenWrt 24.10+ init script for IPv6 Monitor

USE_PROCD=1
START=99
STOP=10

SCRIPT_PATH="/etc/ppp/monitor_ipv6.sh"
PIDFILE="/var/run/ipv6-monitor.pid"
LOGFILE="/var/log/ipv6-monitor.log"

start_service() {
    # 检查脚本是否存在
    [ -x "$SCRIPT_PATH" ] || {
        logger -t "ipv6-monitor" "Script not found or not executable: $SCRIPT_PATH"
        return 1
    }

    # 创建日志目录
    mkdir -p /var/log

    # 使用procd管理进程
    procd_open_instance
    procd_set_param command /bin/sh "$SCRIPT_PATH"
    procd_set_param respawn      # 崩溃后自动重启
    procd_set_param respawn_retry 10  # 重试间隔10秒
    procd_set_param env TZ=UTC-8  # 设置时区（可选）
    procd_set_param pidfile "$PIDFILE"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t "ipv6-monitor" "Service started"
}

stop_service() {
    # procd会自动处理停止
    logger -t "ipv6-monitor" "Service stopped"
}

# 重启服务
restart() {
    stop
    sleep 1
    start
}

# 查看状态
status() {
    if pidof ipv6-monitor.sh >/dev/null 2>&1; then
        echo "ipv6-monitor is running"
        return 0
    else
        echo "ipv6-monitor is not running"
        return 1
    fi
}